generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single admin user for the minimal CMS panel.
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Administrator")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Singleton row that holds all editable site-wide content
// (contact details, about text, vision, mission, hero, socials...).
model SiteSetting {
  id        Int      @id @default(1)
  schoolName String  @default("Zenithia Global School")
  tagline    String  @default("Excellence. Leadership. Success.")

  // Hero
  heroTitle    String @default("Zenithia leads you toward excellence, leadership, and success.")
  heroSubtitle String @default("A future-ready global school nurturing knowledge, discipline and confidence.")
  heroImageUrl String?

  // About / Vision / Mission
  aboutTitle String @default("About Zenithia Global School")
  aboutBody  String @default("") @db.Text
  visionBody String @default("") @db.Text
  missionBody String @default("") @db.Text

  // Contact
  address   String @default("")
  phone     String @default("")
  email     String @default("")
  whatsapp  String @default("")
  mapEmbed  String @default("") @db.Text

  // Socials
  facebook  String @default("")
  instagram String @default("")
  youtube   String @default("")
  twitter   String @default("")

  // Stats shown on home (editable)
  statStudents String @default("100+")
  statTeachers String @default("10+")
  statYears    String @default("7+")
  statAwards   String @default("2+")

  updatedAt DateTime @updatedAt
}

model Facility {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  imageUrl    String?
  icon        String?  // optional emoji / icon name
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feature {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String   @default("")
  category  String   @default("Campus")
  imageUrl  String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Program {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  date        DateTime?
  location    String    @default("")
  imageUrl    String?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  subject   String   @default("")
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Reusable class-teacher / principal presets for the Progress Report tool.
// Stores the staff name and an uploaded signature image (served from
// /media), so saved signatures persist in the database across devices.
model ReportStaff {
  id           String   @id @default(cuid())
  role         String   // "teacher" | "principal"
  name         String
  signatureUrl String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

// Singleton defaults for the Progress Report tool (default subject list and
// default academic year), so the same starting values load every time.
model ReportSettings {
  id           Int      @id @default(1)
  subjects     String[]
  academicYear String   @default("2026-27")
  updatedAt    DateTime @updatedAt
}

// Central student directory. Stored once here and reused (via a class +
// student dropdown) by every maker tool — ID cards, certificates, progress
// reports, letters and posters. Photos are uploaded through /api/upload and
// only the resulting /media link is stored.
model Student {
  id          String   @id @default(cuid())
  admissionNo String   @default("")
  name        String
  klass       String   @default("") // "1" .. "5" (or "LKG", "6 B" …)
  gender      String   @default("") // "male" | "female"
  dob         String   @default("") // free-text date, e.g. 07-08-2014
  fatherName  String   @default("")
  motherName  String   @default("")
  mobile      String   @default("")
  bloodGroup  String   @default("")
  address     String   @default("")
  photoUrl    String? // /media link to the uploaded photo
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([klass])
}

// Central staff / signatory directory. Name + designation + uploaded
// signature image (served from /media), grouped by a category. Reused
// everywhere a signature is printed, instead of re-typing them per tool.
model Staff {
  id           String   @id @default(cuid())
  name         String
  designation  String   @default("")
  category     String   @default("staff") // "teacher" | "principal" | "admin" | "manager" | "staff"
  signatureUrl String? // /media link to the uploaded signature
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}