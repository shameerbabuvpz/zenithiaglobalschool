# ---- Database (Railway provides this automatically when you add a PostgreSQL plugin) ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME"

# ---- Admin auth ----
# Secret used to sign the admin session cookie. Use a long random string.
AUTH_SECRET="change-this-to-a-long-random-secret"
# Default admin login (used by the seed script to create the first admin)
ADMIN_EMAIL="admin@zenithia.net"
ADMIN_PASSWORD="ChangeMe123!"

# ---- File uploads ----
# Where uploaded images are stored on disk.
# Local dev: leave as ./public/uploads
# Railway: mount a Volume and set this to the mount path, e.g. /data/uploads
UPLOAD_DIR="./public/uploads"
# Public base path used to serve uploaded files (served by the /media route).
UPLOAD_PUBLIC_BASE="/media"

# Public site URL (optional, used for metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- AI image generation (optional) ----
# Used only by scripts/generate-facility-images.mjs to create branded facility
# images with Google Gemini. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
